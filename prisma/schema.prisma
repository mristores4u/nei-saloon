// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}


model student {
email String @id
First_name String
Last_Name String
DOB String
Age String
ID_number String
Address String

}


model Course {
email String @id
First_name String
Last_Name String
DOB String
Age String
ID_number String
Address String

}

model Class {
email String @id
First_name String
Last_Name String
DOB String
Age String
ID_number String
Address String

}
model Seccion {
email String @id
First_name String
Last_Name String
DOB String
Age String
ID_number String
Address String

}